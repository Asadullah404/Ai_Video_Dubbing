# ============================================================================
# AI Video Dubbing System - Environment Configuration
# ============================================================================
# Copy this file to '.env' and fill in your API keys before running:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. REQUIRED: Hugging Face API Token
# ----------------------------------------------------------------------------
# Used for PyAnnote audio speaker diarization (separating speaker voices).
# How to get:
# 1. Sign up at https://huggingface.co/
# 2. Accept terms on model pages:
#    - https://huggingface.co/pyannote/speaker-diarization-3.1
#    - https://huggingface.co/pyannote/segmentation-3.0
# 3. Create a User Access Token (Read permissions) at https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# ----------------------------------------------------------------------------
# 2. REQUIRED (for AI translation): Groq API Token, + up to 4 OPTIONAL fallback keys
# ----------------------------------------------------------------------------
# Used for high-speed AI context-aware translation via Groq LLMs.
# If GROQ_TOKEN is omitted, local MarianMT neural machine translation is used instead.
# GROQ_TOKEN_2 .. GROQ_TOKEN_5 are optional extra keys (e.g. from separate free-tier
# accounts) - if the primary key hits Groq's rate limit mid-video, processing automatically
# shifts to the next key in the list, then the next, and so on.
# How to get:
# 1. Create a free account at https://console.groq.com/
# 2. Generate an API Key at https://console.groq.com/keys
GROQ_TOKEN=your_groq_api_key_here
GROQ_TOKEN_2=
GROQ_TOKEN_3=
GROQ_TOKEN_4=
GROQ_TOKEN_5=

# Which Groq chat model to use for translation/condensing. Groq periodically deprecates models
# (e.g. llama-3.3-70b-versatile has been reported decommissioned on some accounts), so this is
# a plain string you can change here instead of editing code. Also selectable per-run in the
# web GUI and the Colab/Kaggle notebook. Options and their free-tier daily token quota (TPD):
#   llama-3.1-8b-instant       - 500K tokens/day (recommended default)
#   openai/gpt-oss-120b        - 200K tokens/day (higher quality)
#   openai/gpt-oss-20b         - 200K tokens/day
#   qwen/qwen3.6-27b           - 200K tokens/day
#   llama-3.3-70b-versatile    - 100K tokens/day (may be decommissioned)
GROQ_MODEL=llama-3.1-8b-instant

# ----------------------------------------------------------------------------
# 2b. OPTIONAL: Cerebras API Key, + up to 4 optional fallback keys
# ----------------------------------------------------------------------------
# A second AI-translation tier, tried automatically whenever Groq is unavailable - all Groq
# keys rate-limited, or a key invalid/revoked (Groq suspends free accounts it flags as
# automated/bulk traffic, which a batch-dubbing pipeline can look like). Not required if Groq
# is working fine, but recommended as a safety net. Cerebras' free tier is far larger than
# Groq's (~1M tokens/day vs. Groq's 500K on llama-3.1-8b-instant).
# How to get:
# 1. Create a free account at https://cloud.cerebras.ai/
# 2. Generate an API Key at https://cloud.cerebras.ai/platform/ (no credit card required)
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_API_KEY_5=

# Which Cerebras chat model to use for translation/condensing when this fallback tier is hit.
#   llama-3.3-70b   - recommended, strong quality, fast
#   llama3.1-8b     - fastest, lighter quality
#   gpt-oss-120b    - highest quality, slower
CEREBRAS_MODEL=llama-3.3-70b

# ----------------------------------------------------------------------------
# 2c. OPTIONAL: Antigravity bridge (your own PC's `agy` CLI, tried BEFORE Groq/Cerebras)
# ----------------------------------------------------------------------------
# Run antigravity_bridge/bridge_server.py on your own PC (see antigravity_bridge/) to translate
# using your local Google Antigravity CLI (`agy`) instead of Groq/Cerebras. It prints a public
# URL (via a free Cloudflare tunnel) and a token each time it starts - paste both here.
# Only takes effect for THIS process (video_dubbing_core.py run directly, colab_server.py, or
# web_gui.py in "remote" mode against colab_server.py). The notebook's Cell 3 one-click
# pipeline does not read this - it always uses Groq/Cerebras only; Cell 2 has its own copy of
# these two variables to paste into instead. Leave blank to use Groq/Cerebras only.
ANTIGRAVITY_BRIDGE_URL=
ANTIGRAVITY_BRIDGE_TOKEN=

# ----------------------------------------------------------------------------
# 3. OPTIONAL: Processing & Model Defaults
# ----------------------------------------------------------------------------
# Preferred Whisper transcription model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3

# Default source and target languages (ISO 639-1 language codes, e.g., en, es, fr, de, ur, hi, ja, zh-cn)
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=es

# Lip-sync engine checkpoint paths (relative to project root)
WAV2LIP_CHECKPOINT=Wav2Lip/wav2lip_gan.pth
S3FD_CHECKPOINT=Wav2Lip/face_detection/detection/sfd/s3fd.pth

# Audio sampling rate for synthesis and analysis (Hz)
AUDIO_SAMPLE_RATE=24000

# CRF (Constant Rate Factor) for output video quality (lower = higher quality, 18-23 recommended)
VIDEO_CRF=18
