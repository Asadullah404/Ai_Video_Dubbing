# ============================================================================
# AI Video Dubbing System - Environment Configuration
# ============================================================================
# Copy this file to '.env' and fill in your API keys before running:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. REQUIRED: Hugging Face API Token
# ----------------------------------------------------------------------------
# Used for PyAnnote audio speaker diarization (separating speaker voices).
# How to get:
# 1. Sign up at https://huggingface.co/
# 2. Accept terms on model pages:
#    - https://huggingface.co/pyannote/speaker-diarization-3.1
#    - https://huggingface.co/pyannote/segmentation-3.0
# 3. Create a User Access Token (Read permissions) at https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# ----------------------------------------------------------------------------
# 2. OPTIONAL: Groq API Token
# ----------------------------------------------------------------------------
# Used for high-speed AI context-aware translation via Groq LLMs.
# If omitted, local MarianMT neural machine translation is used.
# How to get:
# 1. Create a free account at https://console.groq.com/
# 2. Generate an API Key at https://console.groq.com/keys
Groq_TOKEN=your_groq_api_key_here

# ----------------------------------------------------------------------------
# 3. OPTIONAL: Processing & Model Defaults
# ----------------------------------------------------------------------------
# Preferred Whisper transcription model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3

# Default source and target languages (ISO 639-1 language codes, e.g., en, es, fr, de, ur, hi, ja, zh-cn)
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=es

# Lip-sync engine checkpoint paths (relative to project root)
WAV2LIP_CHECKPOINT=Wav2Lip/wav2lip_gan.pth
S3FD_CHECKPOINT=Wav2Lip/face_detection/detection/sfd/s3fd.pth

# Audio sampling rate for synthesis and analysis (Hz)
AUDIO_SAMPLE_RATE=24000

# CRF (Constant Rate Factor) for output video quality (lower = higher quality, 18-23 recommended)
VIDEO_CRF=18
